    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
